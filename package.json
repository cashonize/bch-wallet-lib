{
  "name": "bch-wallet-lib",
  "version": "0.1.0",
  "description": "Bitcoin Cash wallet library with CashTokens support, continued from mainnet-js",
  "keywords": [
    "bch",
    "bitcoin cash",
    "cashtokens",
    "wallet"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb/index.d.ts",
      "import": "./dist/indexeddb/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:dist-imports": "node scripts/check-dist-imports.mjs",
    "check:dist-errors": "node scripts/check-dist-errors.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "USE_MOCK_PROVIDER=1 vitest run --config test/vitest.config.ts",
    "test:regtest": "vitest run --config test/vitest.config.ts",
    "test:browser": "USE_MOCK_PROVIDER=1 vitest run --config test/vitest.config.browser.ts",
    "test:browser:regtest": "vitest run --config test/vitest.config.browser.ts",
    "coverage": "COVERAGE=true pnpm test",
    "regtest:up": "./test/docker/start.sh",
    "regtest:down": "./test/docker/stop.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@electrum-cash/network": "^4.4.8",
    "@electrum-cash/web-socket": "^4.2.0"
  },
  "devDependencies": {
    "@paryonusd/mem-cash": "0.1.0",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^18.0.8",
    "fake-indexeddb": "^6.2.5",
    "node-localstorage": "^3.0.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.49.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^26 || ^24 || ^22.12.0"
  },
  "packageManager": "pnpm@11.10.0"
}
