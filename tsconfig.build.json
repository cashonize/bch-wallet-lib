{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "declarationMap": false,
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.browser.ts",
    "src/network/MockNetworkProvider.ts",
    "src/network/Connection.ts"
  ]
}
